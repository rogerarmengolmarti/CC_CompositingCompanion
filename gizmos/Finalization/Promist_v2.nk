 addUserKnob {7 blurSize l "Blur Size"}
 blurSize 10
 addUserKnob {7 amount l Amount}
 amount 0.04
 addUserKnob {26 ""}
 addUserKnob {22 reset_btn l reset T "nuke.thisNode()\['blurSize'].setValue(20)\nnuke.thisNode()\['exponent'].setValue(1)\nnuke.thisNode()\['amount'].setValue(0.2)\nnuke.thisNode()\['blurMult'].setValue(1)" +STARTLINE}
}
