set cut_paste_input [stack 0]
version 15.2 v6
push $cut_paste_input
add_layer {BrshDistribution BrshDistribution.red BrshDistribution.green BrshDistribution.blue BrshDistribution.alpha}
Group {
 name Bilateral_1
 tile_color 0x29a580ff
 selected true
 xpos 699
 ypos 8227
 disable_group_view true
 addUserKnob {20 Settings l Setttings}
 addUserKnob {26 scaling_TXT l "" +STARTLINE T "<font color=#4cc799><font size=\"4\"><b><br>\nBilateral\n"}
 addUserKnob {41 size l "Blur Size" t "Amount of blur applied to the brush" T Bilateral5.size}
 addUserKnob {41 positionalSigma l "Brush Detect" t "Higher values help detect brushes, makes them harder.\n\nRecomended Value: 8" T Bilateral5.positionalSigma}
 addUserKnob {41 colorSigma l Soften t "Lower values harden the brushes, higher values make them softer and less defined.\n\nRecomended value: 0.1" T Bilateral5.colorSigma}
 addUserKnob {41 filter l Filter T Bilateral5.filter}
 addUserKnob {26 ""}
 addUserKnob {26 signature l "" +STARTLINE T "<font color=#aaaaaa><font size=\"4\">Bilateral</font><font size=\"3\"> v1.0.0 - by Roger Armengol Martí</font>"}
 addUserKnob {20 io l IO}
 addUserKnob {26 scaling_TXT_1 l "" +STARTLINE T "<font color=#4cc799><font size=\"4\"><b><br>\nInput"}
 addUserKnob {41 channels l Channels T Bilateral5.channels}
 addUserKnob {41 guide l "Guide Channels" T Bilateral5.guide}
 addUserKnob {26 "" l Mask T ""}
 addUserKnob {41 maskChannelMask l "" -STARTLINE T Bilateral5.maskChannelMask}
 addUserKnob {41 invertMask l Invert -STARTLINE T Bilateral5.invertMask}
 addUserKnob {26 ""}
 addUserKnob {26 scaling_TXT_2 l "" +STARTLINE T "<font color=#4cc799><font size=\"4\"><b><br>\nOutput"}
 addUserKnob {41 mix l Mix T Bilateral5.mix}
}
 Input {
  inputs 0
  name Input1
  xpos 508
  ypos 281
 }
 Dot {
  name Dot1
  xpos 542
  ypos 350
 }
set Nb0a86000 [stack 0]
 Dot {
  name Dot2
  xpos 662
  ypos 447
 }
push $Nb0a86000
 Dot {
  name Dot3
  xpos 431
  ypos 447
 }
push $Nb0a86000
 Bilateral2 {
  inputs 3
  channels rgb
  guide BrshDistribution
  size 11.4
  positionalSigma 7.6
  colorSigma 0.1
  maskChannelMask none
  name Bilateral5
  xpos 508
  ypos 444
 }
 set Cac64f700 [stack 0]
set Nac64f700 [stack 0]
 Output {
  name Output1
  xpos 508
  ypos 544
 }
push $Nac64f700
push 0
 Viewer {
  inputs 2
  frame 1
  frame_range 1-50
  input_number 1
  viewerProcess "ACES 1.0 - SDR Video (sRGB - Display)"
  monitorOutNDISenderName "NukeX - generalWorker_bTools_v001 - Viewer1"
  name Viewer1
  xpos 620
  ypos -9
  hide_input true
 }
end_group
